# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env al repositorio.

# Correo saliente.
# En producción (Render Free) los puertos SMTP 25/465/587 están bloqueados, así que el
# envío se hace por HTTPS. Prioridad: API de Gmail → API de Brevo → SMTP directo.

# Remitente visible. Si se omite se usa EMAIL_USER.
EMAIL_FROM=

# Opción 1: API de Gmail con OAuth2 (alcance https://www.googleapis.com/auth/gmail.send).
# El refresh token se genera en https://developers.google.com/oauthplayground con
# "Use your own OAuth credentials". OJO: si la app de Google Cloud está en estado
# "Prueba", el refresh token caduca a los 7 días y hay que regenerarlo.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Opción 2: API HTTPS de Brevo (remitente verificado en Brevo).
BREVO_API_KEY=

# Opción 3: SMTP directo de Gmail (solo sirve en desarrollo o en planes de Render
# con puertos SMTP desbloqueados). Usa una contraseña de aplicación de Google.
EMAIL_USER=
EMAIL_PASS=

# Seguridad
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Servidor
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
NODE_ENV=development

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pets_products
DB_POOL_LIMIT=50

# Rate limiting (contadores compartidos entre workers de PM2 vía MySQL)
RATE_LIMIT_MAX=300
WRITE_RATE_LIMIT_MAX=120
UPLOAD_RATE_LIMIT_MAX=25
AUTH_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=10
SSE_RATE_LIMIT_MAX=30

# Conexiones SSE simultáneas
SSE_MAX_PER_USER=3
SSE_MAX_PER_IP=10

# Proxies delante del backend: 0 = ninguno, 1 = nginx/ALB, 2 = CDN + proxy.
# Debe coincidir con el número REAL de proxies; un valor mayor permite evadir
# los límites por IP enviando X-Forwarded-For falsos.
TRUST_PROXY_HOPS=0

# Timeouts del servidor (mitigación de conexiones incompletas / slowloris)
HEADERS_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=5000

# Subida de archivos
UPLOAD_MAX_BYTES=5242880
